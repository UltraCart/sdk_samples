**Request \[[Create API Key](https://ultracart.atlassian.net/wiki/spaces/ucdoc/pages/38688545/API+Simple+Key)\]**
```bash
curl -X POST "https://secure.ultracart.com/rest/v2/item/items\\ \
?_expand=content.multimedia" \
  -H "Accept: application/json" \
  -H "Content-Type: application/json; charset=utf-8" \
  -H "X-UltraCart-Api-Version: 2017-03-01" \
  -H "x-ultracart-simple-key: 976892e9c788c00199a693ade98001004b139b72bb4d470199a693ade9800100" \
  -d $'{
    "merchant_item_id": "sample_SQIJNWTX",
    "pricing": {
        "cost": 9.99
    },
    "description": "Sample description for item sample_SQIJNWTX",
    "content": {
        "multimedia": [
            {
                "url": "https://upload.wikimedia.org/wikipedia/en/7/73/Mr._Clean_logo.png",
                "code": "default",
                "description": "Some random image i nabbed from wikipedia"
            }
        ]
    }
}'
```

