  -H "Accept: application/json" \
  -H "Content-Type: application/json; charset=utf-8" \
  -H "X-UltraCart-Api-Version: 2017-03-01" \
  -H "x-ultracart-simple-key: 976892e9c788c00199a693ade98001004b139b72bb4d470199a693ade9800100" \
  -d $'{
    "digital_item_oid": 235448,
    "description": "I have updated the description to this sentence.",
    "original_filename": "ISS_earth.en.jpg",
    "file_size": 68354,
    "creation_dts": "2025-10-13T15:13:54-04:00",
