**Request \[[Create API Key](https://ultracart.atlassian.net/wiki/spaces/ucdoc/pages/38688545/API+Simple+Key)\]**
```bash
curl -X POST "https://secure.ultracart.com/rest/v2/customer/customers\\ \
?_expand=billing%2Cshipping" \
  -H "Accept: application/json" \
  -H "Content-Type: application/json; charset=utf-8" \
  -H "X-UltraCart-Api-Version: 2017-03-01" \
  -H "x-ultracart-simple-key: 9e188d66d77f64019a05ae05ac80010039ccbebb1df9b9019a05ae05ac800100" \
  -d $'{
    "email": "sample_SWLQRDUZ@test.com",
    "password": "initial_password",
    "billing": [
        {
            "first_name": "FirstSWLQRDUZ",
            "last_name": "LastSWLQRDUZ",
            "company": "CompanySWLQRDUZ",
            "country_code": "US",
            "state_region": "GA",
            "city": "Duluth",
            "postal_code": "30097",
            "address1": "11960 Johns Creek Parkway"
        }
    ],
    "shipping": [
        {
            "first_name": "FirstSWLQRDUZ",
            "last_name": "LastSWLQRDUZ",
            "company": "CompanySWLQRDUZ",
            "country_code": "US",
            "state_region": "GA",
            "city": "Duluth",
            "postal_code": "30097",
            "address1": "11960 Johns Creek Parkway"
        }
    ]
}'
